---
import Base from '../layouts/Base.astro';
import HomeHeader from '../components/HomeHeader.astro';
import HomeHero from '../components/HomeHero.astro';
import Movement from '../components/Movement.astro';
import Committee from '../components/Committee.astro';
import FeaturedEvent from '../components/FeaturedEvent.astro';
import Ambassador from '../components/Ambassador.astro';
import HomeFaq from '../components/HomeFaq.astro';
import HomeFooter from '../components/HomeFooter.astro';
---

<Base
  title="No Barriers, No Excuses"
  description="A community-driven movement within triathlon working to reduce bias, increase access, and create fairer environments for all athletes."
>
  <HomeHeader />
  <main>
    <HomeHero />
    <Movement />
    <Committee />
    <FeaturedEvent />
    <Ambassador />
    <HomeFaq />
  </main>
  <HomeFooter />
</Base>
