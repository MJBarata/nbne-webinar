---
import { getCollection, render } from 'astro:content';

const entries = (await getCollection('speakers'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => a.data.order - b.data.order);

const speakers = await Promise.all(
  entries.map(async (entry) => ({
    data: entry.data,
    Bio: (await render(entry)).Content,
  }))
);
---

<section class="section section--dark speakers" id="speakers">
  <div class="shell">
    <p class="eyebrow">The line-up</p>
    <h2>Three stories worth hearing</h2>
    <p class="speakers__intro lead">
      Not polished talks. Real experience in their own words: what they ran into,
      what they did about it, and what they'd tell someone facing the same thing.
    </p>

    <ul class="speakers__grid">
      {
        speakers.map(({ data, Bio }) => (
          <li class="speaker">
            <div class="speaker__photo">
              {data.photo ? (
                <img src={data.photo} alt={data.name} loading="lazy" />
              ) : (
                <span class="speaker__placeholder">Coming soon</span>
              )}
            </div>
            <h3 class="speaker__name">{data.name}</h3>
            <p class="speaker__role">
              {data.role} · {data.organisation}
            </p>
            {data.talkTitle && <p class="speaker__talk">{data.talkTitle}</p>}
            <div class="speaker__bio">
              <Bio />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .speakers__intro {
    max-width: 54ch;
    margin-top: 1.5rem;
    color: var(--muted-on-dark);
  }

  .speakers__grid {
    list-style: none;
    margin: clamp(40px, 6vw, 64px) 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  .speaker {
    background: var(--card);
    border: 1px solid var(--card-line);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .speaker__photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: linear-gradient(140deg, var(--blue-deep), var(--navy));
    display: grid;
    place-items: center;
    margin-bottom: 1.5rem;
  }

  .speaker__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .speaker__placeholder {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
  }

  .speaker__name {
    font-size: 1.35rem;
  }

  .speaker__role {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0.6rem 0 0.9rem;
  }

  .speaker__talk {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .speaker__bio {
    font-size: 0.95rem;
    color: var(--muted-on-dark);
  }

  @media (min-width: 780px) {
    .speakers__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
