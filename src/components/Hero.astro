---
import { getCollection } from 'astro:content';
import event from '../data/event.json';

const speakers = (await getCollection('speakers'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);

const names = speakers.map((s) => s.name);
const withLine =
  names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : names.join('');
---

<section class="hero" id="top">
  <canvas id="hero-gradient" class="hero__gradient" aria-hidden="true"></canvas>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="shell hero__inner">
    <h1 class="hero__title">{event.title}</h1>

    <div class="hero__grid">
      <div class="hero__main">
        <div class="hero__actions">
          <a class="btn btn--light hero__cta" href="#register">{event.registerLabel}, it's free</a>
          <a class="btn btn--ghost hero__cta" href="#agenda">See the hour</a>
        </div>

        {
          speakers.length > 0 && (
            <div class="hero__with">
              <div class="hero__faces" aria-hidden="true">
                {speakers.map((s) =>
                  s.photo ? <img src={s.photo} alt="" width="48" height="48" /> : null
                )}
              </div>
              <p>With {withLine}</p>
            </div>
          )
        }

        <img
          class="hero__partner"
          src="/img/europe-triathlon.webp"
          alt="Europe Triathlon"
          width="150"
        />
      </div>

      <div class="hero__clock" data-countdown={event.date}>
        <p class="hero__clock-when">
          <span class="hero__clock-dot" aria-hidden="true"></span>
          {event.shortDate} · {event.timeLabel.split('·')[0].trim()}
        </p>
        <div class="hero__clock-digits" role="timer" aria-label="Time until the webinar starts">
          <div><span data-unit="d">--</span><small>days</small></div>
          <span class="hero__clock-sep" aria-hidden="true">:</span>
          <div><span data-unit="h">--</span><small>hours</small></div>
          <span class="hero__clock-sep" aria-hidden="true">:</span>
          <div><span data-unit="m">--</span><small>min</small></div>
          <span class="hero__clock-sep" aria-hidden="true">:</span>
          <div class="hero__clock-sec"><span data-unit="s">--</span><small>sec</small></div>
        </div>
        <p class="hero__clock-live" hidden>We're live. Grab the link from your email.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const clock = document.querySelector('[data-countdown]');
  if (clock instanceof HTMLElement) {
    const target = new Date(clock.dataset.countdown ?? '').getTime();
    const units = {
      d: clock.querySelector('[data-unit="d"]'),
      h: clock.querySelector('[data-unit="h"]'),
      m: clock.querySelector('[data-unit="m"]'),
      s: clock.querySelector('[data-unit="s"]'),
    };
    const live = clock.querySelector('.hero__clock-live');
    const digits = clock.querySelector('.hero__clock-digits');
    const pad = (n: number) => String(n).padStart(2, '0');
    let timer = 0;
    const render = () => {
      let diff = target - Date.now();
      if (Number.isNaN(target)) {
        clock.hidden = true;
        return;
      }
      if (diff <= 0) {
        if (digits instanceof HTMLElement) digits.hidden = true;
        if (live instanceof HTMLElement) live.hidden = false;
        window.clearInterval(timer);
        return;
      }
      const d = Math.floor(diff / 86400000);
      diff -= d * 86400000;
      const h = Math.floor(diff / 3600000);
      diff -= h * 3600000;
      const m = Math.floor(diff / 60000);
      diff -= m * 60000;
      const s = Math.floor(diff / 1000);
      if (units.d) units.d.textContent = pad(d);
      if (units.h) units.h.textContent = pad(h);
      if (units.m) units.m.textContent = pad(m);
      if (units.s) units.s.textContent = pad(s);
    };
    render();
    timer = window.setInterval(render, 1000);
  }
</script>

<script>
  import { NeatGradient } from '@firecms/neat';

  const canvas = document.getElementById('hero-gradient');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas instanceof HTMLCanvasElement) {
    new NeatGradient({
      ref: canvas,
      colors: [
        { color: '#8181FF', enabled: true },
        { color: '#FF7A9B', enabled: true },
        { color: '#FF8F8F', enabled: true },
        { color: '#FFBA96', enabled: true },
        { color: '#FFF8B3', enabled: false },
      ],
      speed: prefersReducedMotion ? 0 : 2,
      horizontalPressure: 5,
      verticalPressure: 6,
      waveFrequencyX: 2,
      waveFrequencyY: 3,
      waveAmplitude: 1,
      shadows: 6,
      highlights: 8,
      colorBrightness: 1,
      colorSaturation: 7,
      wireframe: false,
      colorBlending: 10,
      backgroundColor: '#000000',
      backgroundAlpha: 1,
      grainScale: 3,
      grainSparsity: 0,
      grainIntensity: 0.8,
      grainSpeed: 2.2,
      resolution: 1.1,
      yOffset: 0,
      yOffsetWaveMultiplier: 6.6,
      yOffsetColorMultiplier: 4,
      yOffsetFlowMultiplier: 18.1,
      flowDistortionA: 3.7,
      flowDistortionB: 1.8,
      flowScale: 3.4,
      flowEase: 0.22,
      flowEnabled: true,
      enableProceduralTexture: false,
      transparentTextureVoid: false,
      textureVoidLikelihood: 0.27,
      textureVoidWidthMin: 60,
      textureVoidWidthMax: 420,
      textureBandDensity: 1.2,
      textureColorBlending: 0.06,
      textureSeed: 333,
      textureEase: 0.25,
      proceduralBackgroundColor: '#0E0707',
      textureShapeTriangles: 20,
      textureShapeCircles: 15,
      textureShapeBars: 15,
      textureShapeSquiggles: 10,
      domainWarpEnabled: false,
      domainWarpIntensity: 0,
      domainWarpScale: 3,
      vignetteIntensity: 0,
      vignetteRadius: 0.8,
      fresnelEnabled: false,
      fresnelPower: 2,
      fresnelIntensity: 0.5,
      fresnelColor: '#FFFFFF',
      iridescenceEnabled: false,
      iridescenceIntensity: 0.5,
      iridescenceSpeed: 1,
      bloomIntensity: 0,
      bloomThreshold: 0.7,
      chromaticAberration: 0,
      shapeType: 'plane',
      shapeRotationX: 0,
      shapeRotationY: 0,
      shapeRotationZ: 0,
      shapeAutoRotateSpeedX: 0,
      shapeAutoRotateSpeedY: 0,
      sphereRadius: 15,
      torusRadius: 15,
      torusTube: 5,
      cylinderRadius: 10,
      cylinderHeight: 40,
      planeBend: 0,
      planeTwist: 0,
      silhouetteFade: 0.25,
      cylinderFade: 0.08,
      ribbonFade: 0.05,
      flatShading: true,
      cameraLock: true,
      cameraX: 0,
      cameraY: 0,
      cameraZ: 0,
      cameraRotationX: 0,
      cameraRotationY: 0,
      cameraRotationZ: 0,
      cameraZoom: 1,
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--blue-deep);
    color: var(--white);
    padding-top: calc(var(--header-h) + clamp(56px, 8vw, 104px));
    padding-bottom: clamp(64px, 8vw, 104px);
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* The coral gradient runs very light in places, so darken it behind the copy. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(100deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.28) 45%, rgba(0, 0, 0, 0) 78%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.35) 0%, rgba(0, 0, 0, 0) 45%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__title {
    font-weight: 600;
    font-size: clamp(3rem, 8.4vw, 7.4rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    max-width: 12ch;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 48px;
    align-items: end;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__cta {
    font-size: 1.05rem;
    padding: 1rem 1.6rem;
  }

  .hero__with {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 2rem;
  }

  .hero__faces {
    display: flex;
    flex-shrink: 0;
  }

  .hero__faces img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 20%;
    border: 2px solid rgba(0, 0, 0, 0.6);
  }

  .hero__faces img + img {
    margin-left: -12px;
  }

  .hero__with p {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.45);
  }

  .hero__partner {
    margin-top: 2.5rem;
    width: 140px;
    height: auto;
  }

  .hero__clock {
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .hero__clock-when {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }

  .hero__clock-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff7a9b;
    animation: hero-blink 1s steps(1) infinite;
  }

  .hero__clock-digits {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 16px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
  }

  .hero__clock-digits > div > span {
    display: block;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
  }

  .hero__clock-digits small {
    display: block;
    margin-top: 6px;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero__clock-sep {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.15;
    color: rgba(255, 255, 255, 0.35);
  }

  .hero__clock-sec > span {
    color: var(--accent);
  }

  .hero__clock-live {
    margin: 16px 0 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.1rem;
  }

  @keyframes hero-blink {
    50% {
      opacity: 0.25;
    }
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .hero__clock-digits {
      gap: 8px;
    }

    .hero__clock-digits > div > span {
      font-size: 32px;
    }

    .hero__clock-sep {
      font-size: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__clock-dot {
      animation: none;
    }
  }
</style>
