---
import event from '../data/event.json';
---

<section class="hero">
  <canvas id="hero-gradient" class="hero__gradient" aria-hidden="true"></canvas>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="shell hero__inner">
    <p class="eyebrow">{event.eyebrow}</p>
    <h1 class="hero__title">{event.title}</h1>

    <dl class="hero__facts">
      <div>
        <dt>Date</dt>
        <dd>{event.dateLabel}</dd>
      </div>
      <div>
        <dt>Time</dt>
        <dd>{event.timeLabel}</dd>
      </div>
      <div>
        <dt>Where</dt>
        <dd>{event.format}</dd>
      </div>
    </dl>

    <div class="hero__actions">
      <a class="btn btn--light hero__cta" href="#register">{event.registerLabel}</a>
      <a class="btn btn--ghost" href="#agenda">See the agenda</a>
    </div>

    <div class="hero__countdown" data-countdown={event.date} hidden>
      <span data-countdown-value></span> until we go live
    </div>

    <img
      class="hero__partner"
      src="/img/europe-triathlon.webp"
      alt="Europe Triathlon"
      width="150"
    />
  </div>
</section>

<script>
  const el = document.querySelector('[data-countdown]');
  const out = document.querySelector('[data-countdown-value]');

  if (el instanceof HTMLElement && out) {
    const target = new Date(el.dataset.countdown ?? '').getTime();

    const render = () => {
      const diff = target - Date.now();
      if (Number.isNaN(target) || diff <= 0) {
        el.hidden = true;
        return;
      }
      const days = Math.floor(diff / 86400000);
      const hours = Math.floor((diff % 86400000) / 3600000);
      out.textContent = days > 0 ? `${days} days, ${hours} hours` : `${hours} hours`;
      el.hidden = false;
    };

    render();
    setInterval(render, 60000);
  }
</script>

<script>
  import { NeatGradient } from '@firecms/neat';

  const canvas = document.getElementById('hero-gradient');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas instanceof HTMLCanvasElement) {
    new NeatGradient({
      ref: canvas,
      colors: [
        { color: '#8181FF', enabled: true },
        { color: '#FF7A9B', enabled: true },
        { color: '#FF8F8F', enabled: true },
        { color: '#FFBA96', enabled: true },
        { color: '#FFF8B3', enabled: false },
      ],
      speed: prefersReducedMotion ? 0 : 2,
      horizontalPressure: 5,
      verticalPressure: 6,
      waveFrequencyX: 2,
      waveFrequencyY: 3,
      waveAmplitude: 1,
      shadows: 6,
      highlights: 8,
      colorBrightness: 1,
      colorSaturation: 7,
      wireframe: false,
      colorBlending: 10,
      backgroundColor: '#000000',
      backgroundAlpha: 1,
      grainScale: 3,
      grainSparsity: 0,
      grainIntensity: 0.8,
      grainSpeed: 2.2,
      resolution: 1.1,
      yOffset: 0,
      yOffsetWaveMultiplier: 6.6,
      yOffsetColorMultiplier: 4,
      yOffsetFlowMultiplier: 18.1,
      flowDistortionA: 3.7,
      flowDistortionB: 1.8,
      flowScale: 3.4,
      flowEase: 0.22,
      flowEnabled: true,
      enableProceduralTexture: false,
      transparentTextureVoid: false,
      textureVoidLikelihood: 0.27,
      textureVoidWidthMin: 60,
      textureVoidWidthMax: 420,
      textureBandDensity: 1.2,
      textureColorBlending: 0.06,
      textureSeed: 333,
      textureEase: 0.25,
      proceduralBackgroundColor: '#0E0707',
      textureShapeTriangles: 20,
      textureShapeCircles: 15,
      textureShapeBars: 15,
      textureShapeSquiggles: 10,
      domainWarpEnabled: false,
      domainWarpIntensity: 0,
      domainWarpScale: 3,
      vignetteIntensity: 0,
      vignetteRadius: 0.8,
      fresnelEnabled: false,
      fresnelPower: 2,
      fresnelIntensity: 0.5,
      fresnelColor: '#FFFFFF',
      iridescenceEnabled: false,
      iridescenceIntensity: 0.5,
      iridescenceSpeed: 1,
      bloomIntensity: 0,
      bloomThreshold: 0.7,
      chromaticAberration: 0,
      shapeType: 'plane',
      shapeRotationX: 0,
      shapeRotationY: 0,
      shapeRotationZ: 0,
      shapeAutoRotateSpeedX: 0,
      shapeAutoRotateSpeedY: 0,
      sphereRadius: 15,
      torusRadius: 15,
      torusTube: 5,
      cylinderRadius: 10,
      cylinderHeight: 40,
      planeBend: 0,
      planeTwist: 0,
      silhouetteFade: 0.25,
      cylinderFade: 0.08,
      ribbonFade: 0.05,
      flatShading: true,
      cameraLock: true,
      cameraX: 0,
      cameraY: 0,
      cameraZ: 0,
      cameraRotationX: 0,
      cameraRotationY: 0,
      cameraRotationZ: 0,
      cameraZoom: 1,
    });
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--blue-deep);
    color: var(--white);
    padding-top: calc(var(--header-h) + clamp(56px, 8vw, 104px));
    padding-bottom: clamp(72px, 10vw, 132px);
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* The coral gradient runs very light in places, so darken it behind the copy. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(100deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.28) 45%, rgba(0, 0, 0, 0) 78%),
      linear-gradient(0deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0) 40%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__inner .eyebrow {
    color: var(--white);
  }

  .hero__inner .eyebrow,
  .hero__inner .hero__title,
  .hero__inner .hero__facts,
  .hero__inner .hero__countdown {
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }

  .hero__title {
    max-width: 15ch;
    margin-bottom: 2.5rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 0 0 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
  }

  .hero__facts dt {
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 0.35rem;
  }

  .hero__facts dd {
    margin: 0;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__countdown {
    margin-top: 1.5rem;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__countdown span {
    color: var(--white);
    font-weight: 600;
  }

  .hero__partner {
    margin-top: 3.5rem;
    width: 140px;
    height: auto;
  }
</style>
