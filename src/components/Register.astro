---
import event from '../data/event.json';

const isPlaceholder = event.registerEmbedUrl.includes('REPLACE_WITH');
const showEmbed = event.showRegisterEmbed && !isPlaceholder;
---

<section class="section section--dark register" id="register">
  <div class="shell register__grid">
    <div class="register__copy">
      <h2 class="register__heading">Save your seat</h2>
      <p class="register__intro">
        Free and online. Register once and you'll get the joining link, the recording
        afterwards and the roundtable invite.
      </p>
    </div>

    {
      showEmbed ? (
        <div class="register__embed">
          <iframe
            src={event.registerEmbedUrl}
            title="Registration form"
            width="100%"
            height="900"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            loading="lazy"
          >
            Loading the registration form…
          </iframe>
        </div>
      ) : (
        <div class="register__fallback">
          <p>
            {isPlaceholder
              ? 'The registration form is being set up. Check back shortly.'
              : 'Registration opens in a new tab.'}
          </p>
          {!isPlaceholder && (
            <a
              class="btn btn--primary"
              href={event.registerUrl}
              target="_blank"
              rel="noopener"
            >
              {event.registerLabel}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .register__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .register__heading {
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .register__intro {
    max-width: 34ch;
    margin-top: 1.5rem;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--muted-on-dark);
  }

  .register__embed {
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .register__embed iframe {
    display: block;
    border: 0;
  }

  .register__fallback {
    padding: clamp(28px, 5vw, 48px);
    background: var(--card);
    border: 1px solid var(--card-line);
    border-radius: var(--radius-lg);
  }

  .register__fallback p {
    margin-bottom: 1.5rem;
    color: var(--muted-on-dark);
  }

  @media (max-width: 860px) {
    .register__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
