---
import event from '../data/event.json';
---

<footer class="footer">
  <div class="shell">
    <p class="footer__headline">An equal start for all. No excuses</p>
    <div class="footer__meta">
      <div class="footer__brand">
        <img src="/img/europe-triathlon.webp" alt="Europe Triathlon" width="120" />
        <p>{event.tagline} Europe Triathlon · Women's Committee</p>
      </div>
      <a class="btn btn--light" href="#register">{event.registerLabel}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--black);
    color: var(--white);
    padding-block: clamp(80px, 10vw, 128px) 56px;
    overflow: hidden;
  }

  .footer__headline {
    margin: 0;
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 8vw, 6.8rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
    margin-top: clamp(48px, 6vw, 72px);
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .footer__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .footer__brand img {
    width: 110px;
    height: auto;
  }

  .footer__brand p {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--muted-on-dark);
  }
</style>
