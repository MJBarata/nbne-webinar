---
import event from '../data/event.json';
---

<footer class="footer">
  <div class="shell">
    <h2 class="footer__headline">Let's fight for an equal start for all.</h2>
    <p class="footer__tagline">{event.tagline}</p>
    <a class="btn btn--primary" href="#register">{event.registerLabel}</a>

    <div class="footer__meta">
      <img src="/img/europe-triathlon.webp" alt="Europe Triathlon" width="120" />
      <p>Europe Triathlon · Women's Committee</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--black);
    color: var(--white);
    padding-block: clamp(64px, 9vw, 120px);
    text-align: center;
  }

  .footer__headline {
    max-width: 18ch;
    margin-inline: auto;
  }

  .footer__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    margin: 2rem 0;
  }

  .footer__meta {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--muted-on-dark);
  }

  .footer__meta img {
    width: 110px;
    height: auto;
  }
</style>
