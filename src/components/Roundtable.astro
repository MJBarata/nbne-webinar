---
import roundtable from '../data/roundtable.json';
---

<section class="section section--blue roundtable" id="roundtable">
  <div class="shell roundtable__inner">
    <div>
      <p class="eyebrow">{roundtable.eyebrow}</p>
      <h2>{roundtable.title}</h2>
      <p class="roundtable__date">{roundtable.dateLabel}</p>
    </div>
    <div class="roundtable__body">
      <p class="lead">{roundtable.body}</p>
      <p class="roundtable__note">{roundtable.note}</p>
    </div>
  </div>
</section>

<style>
  .roundtable__inner {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }

  .roundtable__date {
    font-family: var(--font-ui);
    font-weight: 600;
    margin-top: 1rem;
    color: var(--accent);
  }

  .roundtable__body {
    max-width: 46ch;
  }

  .roundtable__note {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.75);
  }

  @media (min-width: 860px) {
    .roundtable__inner {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>
